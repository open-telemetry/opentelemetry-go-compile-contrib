{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "schedule": [
    "* 0-7 1,15 * *"
  ],
  "automergeSchedule": [
    "* * 8-14,22-28 * *"
  ],
  "updateNotScheduled": false,
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "platformAutomerge": false,
  "postUpdateOptions": [
    "gomodTidyAll",
    "gomodUpdateImportPaths"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "WEAVER_IMAGE\\s*\\?=\\s*(?<depName>[^:]+):(?<currentValue>v[^\\s]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      // The WEAVER_IMAGE reference in the Makefile stays tag-only. Renovate's
      // docker:pinDigests preset (part of config:best-practices) must not
      // pin it to a digest.
      "matchDepNames": [
        "otel/weaver"
      ],
      "pinDigests": false
    },
    {
      // Intra-repository modules are linked via local replace directives and
      // updated together by make crosslink.
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "go.opentelemetry.io/otelc-contrib/**"
      ],
      "enabled": false
    },
    {
      "dependencyDashboardCategory": "CI Tooling",
      "matchCategories": [
        "ci"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "groupName": "all ci dependencies",
      "groupSlug": "all-ci-deps",
      "matchCategories": [
        "ci"
      ],
      "matchUpdateTypes": [
        "!major"
      ],
      "schedule": [
        "* 0-7 1 * *"
      ],
      "automerge": true
    },
    {
      "groupName": "all dependencies",
      "groupSlug": "all-deps",
      "matchCategories": [
        "!ci"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest"
      ],
      "matchPackageNames": [
        "*"
      ],
      "automerge": true
    },
    {
      "groupName": "all major docker dependencies",
      "matchCategories": [
        "docker"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "separateMultipleMajor": true
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "matchPackageNames": [
        "!github.com/stretchr/testify",
        "!go.opentelemetry.io/**"
      ],
      "matchFileNames": [
        "instrumentation/**"
      ],
      "dependencyDashboardApproval": true,
      "dependencyDashboardCategory": "Instrumentation Targets"
    },
    {
      // Major updates outside instrumentation/ are not new module targets,
      // but they still wait for dashboard approval.
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "matchPackageNames": [
        "!github.com/stretchr/testify",
        "!go.opentelemetry.io/**"
      ],
      "matchFileNames": [
        "!instrumentation/**"
      ],
      "dependencyDashboardApproval": true,
      "dependencyDashboardCategory": "CI Tooling"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "matchPackageNames": [
        "!github.com/stretchr/testify",
        "!go.opentelemetry.io/**"
      ],
      "matchFileNames": [
        "instrumentation/github.com/openai/openai-go/otelcopenai/go.mod",
        "instrumentation/github.com/openai/openai-go/v2/otelcopenai/go.mod",
        "instrumentation/github.com/stripe/stripe-go/v81/otelcstripe/go.mod",
        "instrumentation/go.mongodb.org/mongo-driver/mongo/otelcmongo/go.mod"
      ],
      "enabled": false
    }
  ],
  "labels": [
    "dependencies"
  ]
}

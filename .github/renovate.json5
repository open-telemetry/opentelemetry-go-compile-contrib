{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "schedule": [
    "before 8am on the 1st and 15th day of the month"
  ],
  "updateNotScheduled": false,
  "minimumReleaseAge": "5 days",
  "internalChecksFilter": "strict",
  "platformAutomerge": true,
  "postUpdateOptions": [
    "gomodTidyAll",
    "gomodUpdateImportPaths"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "WEAVER_IMAGE\\s*\\?=\\s*(?<depName>[^:]+):v(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      // Intra-repository modules are linked via local replace directives and
      // updated together by make crosslink.
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "go.opentelemetry.io/otelc-contrib/**"
      ],
      "enabled": false
    },
    {
      "dependencyDashboardCategory": "CI Tooling",
      "matchCategories": [
        "ci"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "groupName": "all ci dependencies",
      "groupSlug": "all-ci-deps",
      "matchCategories": [
        "ci"
      ],
      "matchUpdateTypes": [
        "!major"
      ],
      "schedule": [
        "* 0-7 1 * *"
      ],
      "automerge": true
    },
    {
      "groupName": "all dependencies",
      "groupSlug": "all-deps",
      "matchCategories": [
        "!ci"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest"
      ],
      "matchPackageNames": [
        "*"
      ],
      "automerge": true
    },
    {
      "groupName": "all major docker dependencies",
      "matchCategories": [
        "docker"
      ],
      "matchUpdateTypes": [
        "major"
      ]
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "separateMultipleMajor": true
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "matchPackageNames": [
        "!github.com/stretchr/testify",
        "!go.opentelemetry.io/**"
      ],
      "dependencyDashboardApproval": true,
      "dependencyDashboardCategory": "Instrumentation Targets",
      "dependencyDashboard": {
        "header": "The below instrumentation targets are needing a new module directory created."
      }
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "matchPackageNames": [
        "!github.com/stretchr/testify",
        "!go.opentelemetry.io/**"
      ],
      "matchFileNames": [
        "instrumentation/github.com/openai/openai-go/otelcopenai/go.mod",
        "instrumentation/github.com/openai/openai-go/v2/otelcopenai/go.mod",
        "instrumentation/github.com/stripe/stripe-go/v81/otelcstripe/go.mod",
        "instrumentation/go.mongodb.org/mongo-driver/mongo/otelcmongo/go.mod"
      ],
      "enabled": false
    }
  ],
  "labels": [
    "dependencies"
  ]
}
